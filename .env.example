# ====================================================
# AI Viral Shorts Cutter — Exemplo de configuração
# Copie este arquivo para .env e preencha os valores
# ====================================================

# --- Servidor ---
PORT=3000
NODE_ENV=development
# URL pública da aplicação (necessário para callbacks OAuth do Google)
APP_URL=http://localhost:3000

# --- Gemini AI (Google AI Studio) ---
# Obrigatório para análise de vídeos e geração de cortes
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash

# --- Criptografia (obrigatório em produção) ---
# Chave de 32+ caracteres para criptografia AES-256-GCM de tokens OAuth
# Gere com: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# --- Google OAuth 2.0 (necessário para login e publicação no YouTube) ---
# Crie credenciais em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=