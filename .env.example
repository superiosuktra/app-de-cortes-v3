# ====================================================
# AI Viral Shorts Cutter — Exemplo de configuração
# Copie este arquivo para .env e preencha os valores
# ====================================================

# --- Servidor ---
PORT=3000
NODE_ENV=development
# URL pública da aplicação (necessário para callbacks OAuth do Google e cookies de sessão)
APP_URL=http://localhost:3000

# --- Banco de Dados SQLite ---
# Caminho para o arquivo SQLite persistente (WAL mode ativado por padrão)
SQLITE_DB_PATH=./data/database.sqlite

# --- Gemini AI (Google AI Studio) ---
# Chave da API do Gemini para análise de transcrições e detecção de momentos virais
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash

# --- Criptografia e Sessões (obrigatório em produção) ---
# Chave de 32+ caracteres para criptografia AES-256-GCM de tokens OAuth e hashes de sessão
# Gere com: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# --- Google OAuth 2.0 (necessário para login e publicação no YouTube) ---
# Crie credenciais em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Controle de Concorrência e Processamento de Vídeo ---
# Número máximo de processos FFmpeg simultâneos para evitar sobrecarga de CPU/RAM (padrão: 2)
MAX_CONCURRENT_FFMPEG=2

# --- Modo Demonstração ---
# Habilita explicitamente o login e tokens de demonstração para testes rápidos (falha fechado em produção se ausente)
ENABLE_DEMO_LOGIN=false
